# ===========================================
# User Management System - Environment Template
# Copy to .env and fill the values
# ===========================================

# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_management

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=Salam_Solid_Victory!!
JWT_REFRESH_SECRET=Salam_Solid_Victory!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (Next.js - for API base URL)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mobile (Expo - same API)
# Use same NEXT_PUBLIC_API_URL or EXPO_PUBLIC_API_URL in app config
