# Expo Public Environment Variables
# Copy this file to .env and configure your API URL

# API Base URL
# For Android Emulator: use http://10.0.2.2:4000/api/v1
# For iOS Simulator: use http://localhost:4000/api/v1
# For Physical Device: use http://YOUR_COMPUTER_IP:4000/api/v1 (e.g., http://192.168.1.100:4000/api/v1)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
